<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · SGRH</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
        string Activo(string nombre) => controlador == nombre ? "activo" : "";
    }
    <div class="app">
        <header class="barra-superior">
            <div class="barra-interior">
                <a class="brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-logo">H</span>
                    <span class="brand-nombre">SGRH <span class="brand-sub">· Reservas de Hoteles</span></span>
                </a>

                <nav class="menu">
                    <a class="@Activo("Home")" asp-controller="Home" asp-action="Index"><partial name="_Icono" model="@("inicio")" /> Inicio</a>
                    <a class="@Activo("Hoteles")" asp-controller="Hoteles" asp-action="Index"><partial name="_Icono" model="@("hotel")" /> Hoteles</a>
                    <a class="@Activo("Bloques")" asp-controller="Bloques" asp-action="Index"><partial name="_Icono" model="@("bloque")" /> Bloques</a>
                    <a class="@Activo("Pisos")" asp-controller="Pisos" asp-action="Index"><partial name="_Icono" model="@("piso")" /> Pisos</a>
                    <a class="@Activo("Habitaciones")" asp-controller="Habitaciones" asp-action="Index"><partial name="_Icono" model="@("habitacion")" /> Habitaciones</a>
                    <a class="@Activo("TiposHabitacion")" asp-controller="TiposHabitacion" asp-action="Index"><partial name="_Icono" model="@("tipo")" /> Tipos de habitación</a>
                </nav>

                <div class="usuario-chip">
                    <span>Administrador</span>
                    <span class="avatar">A</span>
                </div>
            </div>
        </header>

        <div class="main">
            <main class="content">
                <div class="migas">
                    <a asp-controller="Home" asp-action="Index">Inicio</a>
                    @if (ViewData["Seccion"] is string seccion)
                    {
                        <span> › </span><a asp-action="Index">@seccion</a>
                    }
                    @if (controlador != "Home")
                    {
                        <span> › @ViewData["Title"]</span>
                    }
                </div>
                <partial name="_Alertas" />
                @RenderBody()
            </main>
        </div>

        <footer class="pie">SGRH · Sistema de Gestión de Reservas de Hoteles · 2026</footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

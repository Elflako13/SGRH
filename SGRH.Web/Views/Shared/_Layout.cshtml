<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Caribe Hoteles</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="sitio">
    @{
        var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
        var actual = Context.Request.Path + Context.Request.QueryString;
    }
    <header class="sitio-barra">
        <div class="sitio-interior">
            <a class="sitio-marca" asp-controller="Home" asp-action="Index">
                <span class="brand-logo">C</span>
                <span>Caribe <b>Hoteles</b></span>
            </a>

            <nav class="sitio-menu">
                <a class="@(controlador == "Home" ? "activo" : "")" asp-controller="Home" asp-action="Index">Hoteles</a>
                @if (User.IsInRole("Cliente"))
                {
                    <a class="@(controlador == "MisReservas" ? "activo" : "")" asp-controller="MisReservas" asp-action="Index">Mis reservas</a>
                }
                @if (User.IsInRole("Administrador"))
                {
                    <a asp-controller="Panel" asp-action="Index">Administración</a>
                }
            </nav>

            <div class="sitio-cuenta">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="sitio-usuario"><span class="avatar">@User.Identity.Name?[0]</span> @User.Identity.Name</span>
                    <form method="post" asp-controller="Cuenta" asp-action="Salir" style="margin:0">
                        <button type="submit" class="btn-app btn-secundario btn-chico">Salir</button>
                    </form>
                }
                else
                {
                    <a class="btn-app btn-secundario btn-chico" asp-controller="Cuenta" asp-action="Ingresar" asp-route-returnUrl="@actual">Iniciar sesión</a>
                    <a class="btn-app btn-primario btn-chico" asp-controller="Cuenta" asp-action="Registro" asp-route-returnUrl="@actual">Crear cuenta</a>
                }
            </div>
        </div>
    </header>

    <main class="sitio-contenido">
        <div class="sitio-alertas"><partial name="_Alertas" /></div>
        @RenderBody()
    </main>

    <footer class="sitio-pie">
        <div class="sitio-interior">
            <div>
                <b>Caribe Hoteles</b><br />
                Hoteles en Santo Domingo, Punta Cana, Santiago y más.
            </div>
            <div>Reservas: 809-555-0100 · reservas@caribehoteles.com</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

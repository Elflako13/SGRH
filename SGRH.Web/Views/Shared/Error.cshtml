@model ErrorViewModel
@{
    ViewData["Title"] = "Ocurrió un error";
}
<div class="panel"><div class="panel-cuerpo">
    <h1 style="font-size:1.4rem">Ocurrió un error al procesar la solicitud</h1>
    <p>El problema quedó registrado. Intente de nuevo; si continúa, contacte al administrador.</p>
    @if (Model.ShowRequestId)
    {
        <p class="resumen">Código de seguimiento: <code>@Model.RequestId</code></p>
    }
    <a class="btn-app btn-primario" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div></div>

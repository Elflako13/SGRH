@model BloqueViewModel
@{
    ViewData["Seccion"] = "Bloques";
    ViewData["Title"] = Model.EsNuevo ? "Nuevo bloque" : "Editar bloque";
    ViewData["Descripcion"] = "Un bloque pertenece a un solo hotel y su nombre no se repite dentro de ese hotel.";
}
<partial name="_Encabezado" />

<div class="panel form-contenedor">
    <form method="post" asp-action="@(Model.EsNuevo ? "Create" : "Edit")" asp-route-id="@(Model.EsNuevo ? null : Model.Id)" class="panel-cuerpo">
        <partial name="_Validacion" />
        <div class="form-grid">
            <div class="form-campo">
                <label asp-for="HotelId"></label>
                @if (Model.EsNuevo)
                {
                    <select class="control" asp-for="HotelId" asp-items="ViewBag.Hoteles"><option value="0">Seleccione un hotel</option></select>
                }
                else
                {
                    <select class="control" asp-items="ViewBag.Hoteles" disabled></select>
                    <input type="hidden" asp-for="HotelId" />
                    <div class="form-ayuda">El bloque no puede cambiar de hotel.</div>
                }
                <span asp-validation-for="HotelId"></span>
            </div>
            <div class="form-campo">
                <label asp-for="Nombre"></label>
                <input class="control" asp-for="Nombre" placeholder="Ej.: Torre A" />
                <span asp-validation-for="Nombre"></span>
            </div>
            <div class="form-campo ancho">
                <label asp-for="Descripcion"></label>
                <textarea class="control" asp-for="Descripcion" rows="3"></textarea>
                <span asp-validation-for="Descripcion"></span>
            </div>
        </div>
        <partial name="_FormPie" />
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

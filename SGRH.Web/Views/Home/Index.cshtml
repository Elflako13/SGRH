@model SitioInicioViewModel
@{
    ViewData["Title"] = "Inicio";
}
<section class="sitio-hero">
    <div class="sitio-interior">
        <h1>Tu próxima estadía en el Caribe empieza aquí</h1>
        <p>Elige tu destino, las fechas y reserva la habitación ideal en cualquiera de nuestros hoteles.</p>
        <partial name="_Buscador" model="Model.Busqueda" />
    </div>
</section>

<section class="sitio-interior sitio-seccion" id="hoteles">
    <h2 class="sitio-titulo">Nuestros hoteles</h2>
    <div class="grid-hoteles">
        @foreach (var hotel in Model.Hoteles)
        {
            <partial name="_TarjetaHotelPublica" model="hotel" />
        }
    </div>
</section>

@if (Model.Tipos.Any())
{
    <section class="sitio-interior sitio-seccion">
        <h2 class="sitio-titulo">Tipos de habitación</h2>
        <div class="grid-tipos">
            @foreach (var tipo in Model.Tipos)
            {
                <div class="panel tipo-card">
                    <div class="panel-cuerpo">
                        <span class="tipo-nombre">@tipo.Nombre</span>
                        <p>@tipo.Descripcion</p>
                        <span class="tipo-precio">Desde <b>@Formato.Moneda(tipo.TarifaBase)</b> / noche</span>
                    </div>
                </div>
            }
        </div>
    </section>
}
